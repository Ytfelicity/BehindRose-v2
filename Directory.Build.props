<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Keep release DLL/PDB metadata independent of the author's checkout. -->
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildThisFileDirectory)=/_/BehindRose/</PathMap>
    <Version>2.0.0-preview.1</Version>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">2.0.0-preview.7</ReleaseVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>Rose in my wake</Company>
    <Authors>Rose in my wake</Authors>
    <UpdateRepository Condition="'$(UpdateRepository)' == ''">https://github.com/Ytfelicity/BehindRose-v2</UpdateRepository>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
