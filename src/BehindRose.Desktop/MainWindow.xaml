<Window x:Class="BehindRose.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rose in my wake · 网络助手" Width="1040" Height="760" MinWidth="760" MinHeight="600" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Icon="Assets/avatar.ico">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="22,0">
   <DockPanel VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" Text="2.0.0 预览版" Style="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><TextBlock Text="❀" FontSize="26" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/><TextBlock Text="Rose in my wake" FontSize="17" VerticalAlignment="Center"/><TextBlock Text="网络助手" Margin="12,0,0,0" Style="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></DockPanel>
  </Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SidebarBrush}" Padding="12,24,12,20"><DockPanel><TextBlock DockPanel.Dock="Bottom" Text="先看清问题&#10;再放心修改" Style="{StaticResource Muted}" Margin="14,10"/><StackPanel x:Name="Navigation"><Button x:Name="OverviewNav" Style="{StaticResource Nav}" Content="网络体检" Tag="overview" Click="Navigate_Click"/><Button x:Name="NetworkNav" Style="{StaticResource Nav}" Content="网络出口检测" Tag="network" Click="Navigate_Click"/><Button x:Name="BackupNav" Style="{StaticResource Nav}" Content="备份与恢复" Tag="backups" Click="Navigate_Click"/><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="设置与关于" Tag="settings" Click="Navigate_Click"/></StackPanel></DockPanel></Border>
   <Grid Grid.Column="1" Margin="28,24,28,18">
    <DockPanel x:Name="OverviewPage"><WrapPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Button x:Name="ReviewButton" Content="一键配置 →" Style="{StaticResource Primary}" Click="Review_Click"/><Button Content="刷新本地体检" Click="Refresh_Click"/><Button Content="网络出口检测" Tag="network" Click="Navigate_Click"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock Text="本地体检" Style="{StaticResource Muted}"/><TextBlock x:Name="OverviewTitle" Text="正在检查本地环境" Style="{StaticResource Heading}"/>
     <TextBlock x:Name="HostSummary" Style="{StaticResource Muted}" Margin="0,0,0,20"/>
     <Border Style="{StaticResource PanelBorder}" Padding="0"><ItemsControl x:Name="FindingsList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding Title}" FontWeight="Medium"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
     <Border x:Name="ResultBanner" Background="{DynamicResource TintBrush}" CornerRadius="8" Padding="16" Visibility="Collapsed" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="ResultTitle" FontWeight="Medium"/><TextBlock x:Name="ResultDetails" Style="{StaticResource Muted}" Margin="0,8,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="重新打开 Clash" Click="ReopenClash_Click"/><Button Content="复检网络" Tag="network" Click="Navigate_Click"/><Button Content="查看备份" Tag="backups" Click="Navigate_Click"/></WrapPanel></StackPanel></Border>
     <TextBlock Text="本地设置不等于实际网络结果。联网检测会在你点击开始后进行。" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer></DockPanel>
    <DockPanel x:Name="PlanPage" Visibility="Collapsed"><StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><CheckBox x:Name="ConfirmOption" Content="我已了解本次改动和生效要求" Click="Confirm_Click"/><WrapPanel Margin="0,6,0,0"><Button x:Name="ApplyButton" Content="备份并应用修改" Style="{StaticResource Primary}" IsEnabled="False" Click="Apply_Click"/><Button Content="返回体检" Tag="overview" Click="Navigate_Click"/></WrapPanel></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="修改预览" Style="{StaticResource Muted}"/><TextBlock Text="先看清这次会改什么" Style="{StaticResource Heading}"/>
     <TextBlock Text="按 sing-mix 配置 DNS 与 AI 分流，开启 TUN 和 DNS 接管，配置浏览器 DNS。修改前保存原始文件和策略，失败时尝试回滚。" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
     <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Text="一键配置范围"/><TextBlock Text="sing-mix DNS 与 AI 策略组 · 系统 TUN 与严格路由 · 浏览器 DNS · 关闭 Clash IPv6" Style="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="保留节点和订阅来源；替换当前订阅的规则、策略组与 DNS。退出 Clash 后可直接应用，完成后再打开。" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
     <TextBlock x:Name="PlanSummary" Style="{StaticResource Muted}" Margin="0,15,0,12"/>
     <ItemsControl x:Name="ChangesList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding AfterText}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="配置文件使用 YAML 解析器保存，排版和注释可能被规范化；备份保留原始字节。" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
    </StackPanel></ScrollViewer></DockPanel>
    <Grid x:Name="NetworkPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="实际网络出口" Style="{StaticResource Heading}"/><TextBlock Text="由应用内浏览器采样；不能代表所有外部浏览器。服务来源及限制在检测页内列出。" Style="{StaticResource Muted}"/></StackPanel><Grid x:Name="NetworkContainer" Grid.Row="1"><TextBlock x:Name="NetworkLoading" Text="正在加载本地检测页面……" Style="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Grid>
    <ScrollViewer x:Name="BackupsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="备份与恢复" Style="{StaticResource Heading}"/><TextBlock Text="选择一条记录，先检查恢复范围。若配置后来又被修改，程序会停止恢复以保留后续改动。" Style="{StaticResource Muted}" Margin="0,0,0,18"/>
     <TextBlock x:Name="BackupMessage" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
     <ItemsControl x:Name="BackupsList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Margin="0,0,0,12"><StackPanel><DockPanel><TextBlock Text="{Binding StateText}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding TimeText}" FontWeight="Medium"/></DockPanel><TextBlock Text="{Binding Scope}" Style="{StaticResource Muted}" Margin="0,8,0,12"/><Button Content="查看恢复范围" HorizontalAlignment="Left" Tag="{Binding Id}" IsEnabled="{Binding CanRestore}" Click="Restore_Click"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <WrapPanel Margin="0,12,0,0"><Button Content="刷新记录" Click="RefreshBackups_Click"/><Button Content="打开备份目录" Click="OpenBackups_Click"/></WrapPanel>
     <TextBlock Text="v1.9 的备份与此版本分开保存。旧备份请使用原 v1.9 程序恢复。" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="设置与关于" Style="{StaticResource Heading}"/><TextBlock x:Name="AboutVersion" Text="Rose in my wake · 网络助手" Margin="0,0,0,20"/>
     <Border Style="{StaticResource PanelBorder}"><StackPanel>
      <TextBlock Text="程序更新"/><TextBlock x:Name="UpdateStatus" Text="启动时检查更新" Style="{StaticResource Muted}" Margin="0,6,0,10"/><Button x:Name="CheckUpdatesButton" Content="检查更新" HorizontalAlignment="Left" Click="CheckUpdates_Click" Margin="0,0,0,20"/>
      <TextBlock Text="外观"/><ComboBox x:Name="ThemePicker" Margin="0,10,0,20" Width="180" HorizontalAlignment="Left" SelectionChanged="Theme_Changed"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
      <CheckBox x:Name="AutoProbeOption" Content="修复后自动联网复检" Click="AutoProbe_Click"/>
      <TextBlock Text="开启后，会在修复成功且重新打开 Clash 后调用 ipify、bash.ws 和公开 STUN 服务。服务方会收到必要请求和来源 IP；默认不查询地区。" Style="{StaticResource Muted}" Margin="21,0,0,16"/>
      <TextBlock Text="数据与权限"/><TextBlock Text="没有账户、遥测或作者服务器代测。日常使用普通权限，配置操作单独请求管理员权限。网络结果只在当前会话保留。" Style="{StaticResource Muted}" Margin="0,6,0,16"/>
      <TextBlock Text="配置识别范围"/><TextBlock Text="Windows x64，Clash Verge Rev 标准配置目录。按实际文件结构与目标字段生成预览；无法识别时说明原因。版本号仅作参考。浏览器策略统一纳入一键配置。" Style="{StaticResource Muted}" Margin="0,6,0,16"/>
      <TextBlock Text="支持作者"/><TextBlock Text="感谢使用 Rose in my wake。支持作者完全自愿，不影响功能。" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
     </StackPanel></Border>
     <WrapPanel Margin="0,20,0,0"><Button Content="查看官方 Clash 发布页" Click="OpenClashPage_Click"/><Button Content="预览诊断报告" Click="Report_Click"/><Button Content="查看第三方许可" Click="Licenses_Click"/></WrapPanel>
     <TextBlock Text="此预览版尚未数字签名。具体测试通过项和实机验收范围见发布包内说明。" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
    <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="{DynamicResource BackgroundBrush}" Padding="25"><StackPanel VerticalAlignment="Center"><TextBlock Text="正在处理配置" Style="{StaticResource Heading}"/><TextBlock x:Name="ProgressText" Text="正在申请管理员权限……" Margin="0,15,0,15"/><ProgressBar IsIndeterminate="True" Height="4"/><TextBlock Text="正在写入或恢复时，请保持程序打开。" Style="{StaticResource Muted}" Margin="0,18,0,0"/></StackPanel></Border>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,7"><TextBlock x:Name="StatusText" Text="准备就绪 · 未发起网络检测" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border>
 </Grid>
</Window>
